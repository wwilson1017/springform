# Server settings, kept in /srv/springform/.env. deploy/setup.sh writes it with fresh secrets;
# this file only documents it. Never commit a real .env.

# The public host name. Point its DNS at the server first; Caddy gets the certificate for it.
DOMAIN=crm.example.com
# The image to run. A fork runs its own, e.g. ghcr.io/your-org/your-fork:latest.
IMAGE=ghcr.io/wwilson1017/springform:latest
# The address people use; invite links and the Google sign-in redirect are built from it.
PUBLIC_URL=https://crm.example.com
# Signs sessions. Generate with: openssl rand -hex 32
SECRET_KEY=
# Encrypts stored credentials (a Fernet key). Keep a copy off-site: without it a restored backup
# cannot read stored credentials. Left blank, the app generates /data/.encryption-key instead.
ENCRYPTION_KEY=
# Optional: send invites and notifications by email through Resend.
RESEND_API_KEY=
MAIL_FROM=
